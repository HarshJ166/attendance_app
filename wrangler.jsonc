// Admin panel (static, built by `npm run build` in admin/) on Cloudflare Workers static assets.
// Deploy: (cd admin && VITE_API_URL=https://geomark-api.onrender.com npm run build) && wrangler deploy
{
  "name": "geomark-admin",
  "compatibility_date": "2026-11-04",
  "preview_urls": false,
  "assets": { "directory": "admin/dist" }
}
